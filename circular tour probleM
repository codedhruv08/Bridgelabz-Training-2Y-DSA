class CircularTour {

    static int findStart(int[] petrol, int[] distance) {
        int start = 0;
        int currPetrol = 0;
        int totalPetrol = 0;

        for (int i = 0; i < petrol.length; i++) {
            int diff = petrol[i] - distance[i];
            currPetrol += diff;
            totalPetrol += diff;

            if (currPetrol < 0) {
                start = i + 1;
                currPetrol = 0;
            }
        }

        return totalPetrol >= 0 ? start : -1;
    }

    public static void main(String[] args) {
        int[] petrol = {6, 3, 7};
        int[] distance = {4, 6, 3};

        System.out.println(findStart(petrol, distance));
    }
}
