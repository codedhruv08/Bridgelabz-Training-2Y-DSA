class Inventory {

    static class Node {
        String name;
        int id, quantity;
        double price;
        Node next;

        Node(String name, int id, int quantity, double price) {
            this.name = name;
            this.id = id;
            this.quantity = quantity;
            this.price = price;
        }
    }

    Node head;

    void addItem(String name, int id, int qty, double price) {
        Node newNode = new Node(name, id, qty, price);
        newNode.next = head;
        head = newNode;
    }

    double totalValue() {
        double total = 0;
        Node temp = head;
        while (temp != null) {
            total += temp.quantity * temp.price;
            temp = temp.next;
        }
        return total;
    }
}
