import java.util.*;

public class NetworkGraph {
    static Map<String, List<String>> graph = new HashMap<>();

    public static void addEdge(String u, String v) {
        graph.putIfAbsent(u, new ArrayList<>());
        graph.putIfAbsent(v, new ArrayList<>());
        graph.get(u).add(v);
        graph.get(v).add(u);
    }

    // 3. Check connected
    public static boolean isConnected() {
        Set<String> visited = new HashSet<>();
        dfs("R1", visited);
        return visited.size() == graph.size();
    }

    private static void dfs(String node, Set<String> visited) {
        if (visited.contains(node)) return;

        visited.add(node);
        for (String nei : graph.get(node)) {
            dfs(nei, visited);
        }
    }

    // 4 & 5 BFS shortest path
    public static int minHops(String start, String end) {
        Queue<String> q = new LinkedList<>();
        Set<String> visited = new HashSet<>();

        q.add(start);
        visited.add(start);
        int hops = 0;

        while (!q.isEmpty()) {
            int size = q.size();

            for (int i=0;i<size;i++) {
                String curr = q.poll();
                if (curr.equals(end)) return hops;

                for (String nei : graph.get(curr)) {
                    if (!visited.contains(nei)) {
                        visited.add(nei);
                        q.add(nei);
                    }
                }
            }
            hops++;
        }
        return -1;
    }

    public static void main(String[] args) {
        addEdge("R1","R2");
        addEdge("R1","R3");
        addEdge("R2","R4");
        addEdge("R3","R4");
        addEdge("R4","R5");
        addEdge("R5","R6");

        System.out.println(isConnected());
        System.out.println(minHops("R1","R6"));
    }
}
