import java.util.*;

public class SocialNetwork {
    static Map<String, List<String>> graph = new HashMap<>();

    public static void addEdge(String u, String v) {
        graph.putIfAbsent(u, new ArrayList<>());
        graph.putIfAbsent(v, new ArrayList<>());
        graph.get(u).add(v);
        graph.get(v).add(u);
    }

    // 2. Find all friends
    public static List<String> getFriends(String user) {
        return graph.getOrDefault(user, new ArrayList<>());
    }

    // 3. Direct connection
    public static boolean isDirect(String u, String v) {
        return graph.getOrDefault(u, new ArrayList<>()).contains(v);
    }

    // 4. Shortest path (BFS)
    public static int shortestPath(String start, String end) {
        Queue<String> q = new LinkedList<>();
        Set<String> visited = new HashSet<>();

        q.add(start);
        visited.add(start);
        int dist = 0;

        while (!q.isEmpty()) {
            int size = q.size();
            for (int i = 0; i < size; i++) {
                String curr = q.poll();
                if (curr.equals(end)) return dist;

                for (String nei : graph.get(curr)) {
                    if (!visited.contains(nei)) {
                        visited.add(nei);
                        q.add(nei);
                    }
                }
            }
            dist++;
        }
        return -1;
    }

    public static void main(String[] args) {
        addEdge("Alice","Bob");
        addEdge("Alice","Charlie");
        addEdge("Bob","David");
        addEdge("Charlie","Eve");
        addEdge("David","Eve");

        System.out.println(getFriends("Alice"));
        System.out.println(isDirect("Bob","Eve"));
        System.out.println(shortestPath("Alice","Eve"));
    }
}
